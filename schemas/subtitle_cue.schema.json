{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SubtitleCue",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "cue_id": { "type": "string", "pattern": "^SUB-" },
    "dialogue_id": { "type": "string", "pattern": "^DLG-" },
    "shot_plan_id": { "type": "string", "pattern": "^SP-" },
    "shot_id": { "type": "string", "minLength": 1 },
    "start_seconds": { "type": "number", "minimum": 0 },
    "end_seconds": { "type": "number", "minimum": 0 },
    "text": { "type": "string", "minLength": 1 },
    "dialogue_text_sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },
    "source_spec_version": { "type": "string", "minLength": 1 },
    "timing_spec_version": { "type": "string", "minLength": 1 }
  },
  "required": [
    "cue_id", "dialogue_id", "shot_plan_id", "shot_id", "start_seconds",
    "end_seconds", "text", "dialogue_text_sha256", "source_spec_version",
    "timing_spec_version"
  ]
}
